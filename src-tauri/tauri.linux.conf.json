{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "nvstraps-rebar",
  "mainBinaryName": "nvstraps-rebar",
  "bundle": {
    "targets": [
      "deb",
      "rpm"
    ],
    "category": "Utility",
    "homepage": "https://github.com/115dkk/NvStrapsReBar-Tauri",
    "shortDescription": "Resizable BAR for NVIDIA GTX 16 and RTX 20 series GPUs",
    "longDescription": "Prepares a motherboard BIOS file that carries the NvStrapsReBar UEFI driver and configures that driver, so that NVIDIA Turing GPUs get a larger Resizable BAR.",
    "linux": {
      "deb": {
        "depends": [
          "pkexec | policykit-1"
        ],
        "desktopTemplate": "linux/nvstraps-rebar.desktop",
        "files": {
          "/usr/lib/nvstraps-rebar/nvstraps-rebar-helper": "../target/x86_64-unknown-linux-musl/release/nvstraps-rebar-helper",
          "/usr/share/polkit-1/actions/io.github.nvstrapsrebar.helper.policy": "linux/io.github.nvstrapsrebar.helper.policy"
        }
      },
      "rpm": {
        "depends": [
          "polkit"
        ],
        "desktopTemplate": "linux/nvstraps-rebar.desktop",
        "files": {
          "/usr/lib/nvstraps-rebar/nvstraps-rebar-helper": "../target/x86_64-unknown-linux-musl/release/nvstraps-rebar-helper",
          "/usr/share/polkit-1/actions/io.github.nvstrapsrebar.helper.policy": "linux/io.github.nvstrapsrebar.helper.policy"
        }
      }
    }
  }
}
